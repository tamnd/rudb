#!/bin/sh
# Run the gate somewhere that is not this machine.
#
# The development laptop is a 460 GB disk with under 30 GB free and three Rust workspaces on it,
# and a full target directory for this one is four gigabytes before the lab under experiments adds
# half of another. Compiling here is the thing most likely to stop the afternoon, so the gate runs
# on one of the Linux boxes, which have the cores anyway.
#
#   scripts/gate              the focused gate on server3
#   scripts/gate server1      the same, on a different machine
#   scripts/gate server3 --full   nothing narrowed
#
# It copies the working tree, including uncommitted work, and works out the diff here rather than
# there. That is not a preference. This checkout is a git worktree, so its `.git` is a file naming a
# directory under the main clone, and the copy of that file on the other machine names a path that
# does not exist there. `cargo xtask ci` ran git, got nothing, said "no git base to compare against"
# and ran the whole workspace, every single time, which made the focus in it dead code from the day
# it was written. So the diff is computed on this side, where git works, and handed over.
set -e

host=server3
case "$1" in
  server1 | server2 | server3) host=$1; shift ;;
  # The Linux on the gaming pc is a WSL2 distro, and the machine's own name answers on the Windows
  # sshd, where rsync gets a cmd.exe and says the syntax of the command is incorrect. The way in is
  # the `gpc` alias, whose proxy starts the distro and holds it up for the length of the session.
  # Both spellings are accepted because both get typed.
  gamingpc | gpc) host=gpc; shift ;;
esac

root=$(cd "$(dirname "$0")/.." && pwd)
name=$(basename "$root")
remote="gate/$name"

rsync -a --delete \
  --exclude '/target' \
  --exclude 'experiments/*/target' \
  --rsync-path "mkdir -p ~/$remote && rsync" \
  "$root/" "$host:$remote/"

# The merge base with the trunk, so a branch is measured against what it branched from rather than
# against its own first commit.
base=$(git -C "$root" merge-base origin/main HEAD 2>/dev/null || true)
if [ -z "$base" ]; then
  base=$(git -C "$root" merge-base main HEAD 2>/dev/null || true)
fi
head=$(git -C "$root" rev-parse HEAD 2>/dev/null || true)
dirty=$(git -C "$root" status --porcelain --untracked-files=all 2>/dev/null || true)

# When the base is already HEAD there is nothing committed on top of the trunk, and the question
# splits in two. With uncommitted work, that work is the whole of the change and the base stays at
# HEAD, which makes the diff below empty and leaves the file list entirely to `git status`. With a
# clean tree there is no other reading than "what did the last commit do", so the previous commit is
# what to measure against.
#
# That first case is the one the gate is run in most often and it used to be the slowest one. A
# fresh branch holding a single uncommitted markdown file was measured against `HEAD~1`, so it saw
# every file of the pull request that had just been merged and rebuilt and retested two crates and
# everything above them in order to check a paragraph. Narrowing it to nothing is worth more than
# every other saving in here put together.
if [ -z "$base" ] || { [ "$base" = "$head" ] && [ -z "$dirty" ]; }; then
  base=$(git -C "$root" rev-parse HEAD~1 2>/dev/null || true)
fi

changed=""
if [ -n "$base" ]; then
  # Committed and uncommitted together. The gate is run before the commit at least as often as
  # after it, and a diff that only sees committed work is a green on a tree that does not build.
  changed=$(
    {
      git -C "$root" diff --name-only "$base...HEAD"
      printf '%s\n' "$dirty" | cut -c4- | sed 's/.* -> //' | tr -d '"'
    } | sed '/^$/d' | sort -u
  )
fi

# A path holding a single quote would end the quoting on the other side of the ssh and turn the rest
# of a filename into a command. There are none here and there is no reason for one, so the answer is
# to notice and stop narrowing rather than to build an escaping scheme for a case that does not
# arise. Running everything is always a correct answer, it is only a slow one.
case "$changed" in
  *\'*) base=""; changed="" ;;
esac

# Non-interactive ssh does not read the profile that puts cargo on the path, so it goes on here.
# shellcheck disable=SC2029
ssh "$host" "export PATH=\$HOME/.cargo/bin:\$PATH; export RUDB_CI_BASE='$base'; export RUDB_CI_CHANGED='$changed'; cd ~/$remote && cargo xtask ci $*"
