* text=auto eol=lf

# Golden files and format fixtures are compared byte for byte, so git must not rewrite them.
tests/**/*.expected -text
tests/**/*.slt -text
tests/**/*.plan -text
tests/**/*.ir -text
# The DuckDB grammar is upstream's bytes and its checksums are in VENDOR, so a line ending
# rewrite here would fail `cargo xtask grammar` on Windows and nowhere else. Marking it vendored
# also keeps it out of the language statistics, which is honest.
crates/rudb-parse/grammar/** -text linguist-vendored

*.duckdb binary
# Not a database file. The same name collision the ignore rules had: this is upstream's license
# text sitting next to upstream's grammar. It keeps -text so the bytes are the bytes VENDOR
# recorded, and it gets diff back so a license change is readable rather than "Bin 1072 bytes".
LICENSE.duckdb -text diff
*.parquet binary
*.rudb binary
*.bin binary
